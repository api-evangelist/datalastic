        {
          "id": "c7616a89-c045-44b5-9c53-f80721ecf5db",
          "name": "Check report status or list reports",
          "request": {
            "name": "Check report status or list reports",
            "description": {
              "content": "Polls the status of an asynchronous report job by report_id. Status progresses through PENDING, IN_PROGRESS, and DONE; when DONE, a result_url download link is returned. Pass report_id=_all to list all of your reports. Checking status is free.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "report"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "report_id",
                  "value": "<string>",
                  "description": "(Required) The report identifier to check, or _all to list all reports."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
