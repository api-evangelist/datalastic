        {
          "id": "9d2743e2-2324-450b-ad5c-ca7d491f9709",
          "name": "Vessel finder search",
          "request": {
            "name": "Vessel finder search",
            "description": {
              "content": "Searches the 750,000+ ship database by name (exact or fuzzy match), type, specific subtype, flag country, gross tonnage, deadweight, dimensions, and year built. Deducts 1 credit per vessel found.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "vessel_find"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "Vessel name to search for."
                },
                {
                  "disabled": false,
                  "key": "fuzzy",
                  "value": "<integer>",
                  "description": "Set to 1 for similar-name matching (Eric matches Erica); 0 for exact name matching."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Vessel type filter (for example Cargo, Tanker, Fishing)."
                },
                {
                  "disabled": false,
                  "key": "type_specific",
                  "value": "<string>",
                  "description": "Vessel subtype filter (for example Crude Oil Tanker). Can be used on its own or combined with type. Use _empty_ to include or exclude vessels whose type is NULL."
                },
                {
                  "disabled": false,
                  "key": "country_iso",
                  "value": "<string>",
                  "description": "Flag country of the vessels as a 2-letter ISO code."
                },
                {
                  "disabled": false,
                  "key": "gross_tonnage_min",
                  "value": "<number>",
                  "description": "Minimum gross tonnage."
                },
                {
                  "disabled": false,
                  "key": "gross_tonnage_max",
                  "value": "<number>",
                  "description": "Maximum gross tonnage."
                },
                {
                  "disabled": false,
                  "key": "deadweight_min",
                  "value": "<number>",
                  "description": "Minimum deadweight tonnage."
                },
                {
                  "disabled": false,
                  "key": "deadweight_max",
                  "value": "<number>",
                  "description": "Maximum deadweight tonnage."
                },
                {
                  "disabled": false,
                  "key": "length_min",
                  "value": "<number>",
                  "description": "Minimum vessel length in meters."
                },
                {
                  "disabled": false,
                  "key": "length_max",
                  "value": "<number>",
                  "description": "Maximum vessel length in meters."
                },
                {
                  "disabled": false,
                  "key": "breadth_min",
                  "value": "<number>",
                  "description": "Minimum vessel breadth in meters."
                },
                {
                  "disabled": false,
                  "key": "breadth_max",
                  "value": "<number>",
                  "description": "Maximum vessel breadth in meters."
                },
                {
                  "disabled": false,
                  "key": "year_built_min",
                  "value": "<integer>",
                  "description": "Earliest year built."
                },
                {
                  "disabled": false,
                  "key": "year_built_max",
                  "value": "<integer>",
                  "description": "Latest year built."
                },
                {
                  "disabled": false,
                  "key": "next",
                  "value": "<string>",
                  "description": "Pagination cursor for retrieving the next page of results."
                }
