          "name": "Historical vessel track",
          "request": {
            "name": "Historical vessel track",
            "description": {
              "content": "Returns past AIS positions for a vessel identified by uuid, mmsi, or imo, filtered by a days lookback or an explicit from/to date range in YYYY-MM-DD format. A maximum of 31 days may be requested from the from date. Each day of data per vessel deducts 1 credit.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "vessel_history"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "uuid",
                  "value": "<string>",
                  "description": "Datalastic vessel UUID."
                },
                {
                  "disabled": false,
                  "key": "mmsi",
                  "value": "<string>",
                  "description": "Vessel Maritime Mobile Service Identity (9-digit number)."
                },
                {
                  "disabled": false,
                  "key": "imo",
                  "value": "<string>",
                  "description": "Vessel International Maritime Organization number (7-digit)."
                },
                {
                  "disabled": false,
                  "key": "days",
                  "value": "<integer>",
                  "description": "Number of days back from today to return data for (for example days=5 returns the last 5 days)."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<date>",
                  "description": "Start date for the data in YYYY-MM-DD format. A maximum of 31 days may be requested from this date."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<date>",
                  "description": "End date for the data in YYYY-MM-DD format."
                }
              ],
              "variable": []
            },
