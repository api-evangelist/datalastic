          "name": "Historical vessel traffic within a radius",
          "request": {
            "name": "Historical vessel traffic within a radius",
            "description": {
              "content": "Replays past vessel traffic for a zone. Cost is calculated as the number of days multiplied by the number of vessels per day (maximum 500 vessels per day).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "inradius_history"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<number>",
                  "description": "Latitude of the zone center point. Requires lon."
                },
                {
                  "disabled": false,
                  "key": "lon",
                  "value": "<number>",
                  "description": "Longitude of the zone center point. Requires lat."
                },
                {
                  "disabled": false,
                  "key": "port_uuid",
                  "value": "<string>",
                  "description": "Port UUID to use as the zone center point."
                },
                {
                  "disabled": false,
                  "key": "port_unlocode",
                  "value": "<string>",
                  "description": "Port UN/LOCODE to use as the zone center point."
                },
                {
                  "disabled": false,
                  "key": "radius",
                  "value": "<number>",
                  "description": "(Required) Search radius in nautical miles. Maximum 50 NM."
                },
                {
                  "disabled": false,
                  "key": "days",
                  "value": "<integer>",
                  "description": "Number of days back from today to return data for (for example days=5 returns the last 5 days)."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<date>",
                  "description": "Start date for the data in YYYY-MM-DD format. A maximum of 31 days may be requested from this date."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<date>",
                  "description": "End date for the data in YYYY-MM-DD format."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
