        {
          "id": "69d18ace-5d44-45e7-a6d8-e87c91ca5f8a",
          "name": "Basic live ship tracking",
          "request": {
            "name": "Basic live ship tracking",
            "description": {
              "content": "Returns the latest real-time AIS data for a single vessel identified by uuid, mmsi, or imo - name, identifiers, country code, type and subtype, latitude, longitude, speed, course, heading, navigational status, destination, and position timestamp. Average response time is 0.005 seconds. Deducts 1 credit per request.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "vessel"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "uuid",
                  "value": "<string>",
                  "description": "Datalastic vessel UUID."
                },
                {
                  "disabled": false,
                  "key": "mmsi",
                  "value": "<string>",
                  "description": "Vessel Maritime Mobile Service Identity (9-digit number)."
                },
                {
                  "disabled": false,
                  "key": "imo",
                  "value": "<string>",
