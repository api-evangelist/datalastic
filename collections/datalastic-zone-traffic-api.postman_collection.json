  "item": [
    {
      "id": "c8773c71-e77d-4d48-834c-3ad0f2613e9f",
      "name": "Zone Traffic",
      "description": {
        "content": "Vessels within a radius of a point, port, or moving vessel.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "6f2ce63b-6411-45bf-8c9a-39fcccbe3562",
          "name": "Vessels within a radius",
          "request": {
            "name": "Vessels within a radius",
            "description": {
              "content": "Returns all vessels within a radius (maximum 50 nautical miles) around either a static point - lat/lon coordinates, a port_uuid, or a port_unlocode - or a dynamic center defined by a moving vessel's uuid, mmsi, or imo. Results can be filtered by vessel type, specific subtype, exclusions, and navigational status. Deducts 1 credit per vessel found (maximum 500).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "vessel_inradius"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<number>",
                  "description": "Latitude of the static center point. Requires lon."
                },
                {
                  "disabled": false,
                  "key": "lon",
                  "value": "<number>",
                  "description": "Longitude of the static center point. Requires lat."
                },
                {
                  "disabled": false,
                  "key": "port_uuid",
                  "value": "<string>",
                  "description": "Port UUID to use as the center point."
                },
                {
                  "disabled": false,
                  "key": "port_unlocode",
                  "value": "<string>",
                  "description": "Port UN/LOCODE to use as the center point."
                },
                {
                  "disabled": false,
                  "key": "uuid",
                  "value": "<string>",
                  "description": "Vessel UUID to use as a dynamic (moving) center point."
                },
                {
                  "disabled": false,
                  "key": "mmsi",
                  "value": "<string>",
                  "description": "Vessel MMSI to use as a dynamic (moving) center point."
                },
                {
                  "disabled": false,
                  "key": "imo",
                  "value": "<string>",
                  "description": "Vessel IMO number to use as a dynamic (moving) center point."
                },
                {
                  "disabled": false,
                  "key": "radius",
                  "value": "<number>",
                  "description": "(Required) Search radius in nautical miles. Maximum 50 NM."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Vessel type filter (for example Cargo, Tanker, Fishing)."
                },
                {
                  "disabled": false,
                  "key": "type_specific",
                  "value": "<string>",
                  "description": "Vessel subtype filter (for example Crude Oil Tanker). Can be used on its own or combined with type. Use _empty_ to include or exclude vessels whose type is NULL."
                },
                {
                  "disabled": false,
                  "key": "exclude",
                  "value": "<string>",
                  "description": "Vessel types to exclude from the results."
                },
                {
                  "disabled": false,
                  "key": "nav_status",
                  "value": "<integer>",
                  "description": "Numeric navigational status code to filter by."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
